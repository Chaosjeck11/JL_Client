# ── Build-Scripts (build.sh / android_build.sh / linux_build.sh) ─────────────
# SSH-User auf dem Deploy-Server
SERVER_USER=ben
# Tailscale-IP oder Hostname des Servers
SERVER_HOST=100.x.x.x
# Zielpfad auf dem Server für die Builds
SERVER_PATH=/mnt/docker/JL_Backend/Builds

# ── Android Keystore ──────────────────────────────────────────────────────────
KEYSTORE_PASSWORD=dein_keystore_passwort
KEY_PASSWORD=dein_key_passwort

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Standard-Backend-URL, die im Login-Screen vorausgefüllt wird.
# Leer lassen → Login-Screen zeigt leeres Feld (Nutzer muss selbst eintragen).
VITE_API_BASE_URL=https://deine-domain.de
