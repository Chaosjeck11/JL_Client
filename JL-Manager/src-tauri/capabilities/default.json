{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
  "core:default",
  "opener:default",
  "opener:allow-open-path",
  "os:default",
  "fs:allow-write-file",
  "fs:scope-download-recursive",
  "install:allow-install-apk",
  {
    "identifier": "opener:allow-open-path",
    "allow": [{ "path": "$DOWNLOAD/**" }]
  }
  ]
}
